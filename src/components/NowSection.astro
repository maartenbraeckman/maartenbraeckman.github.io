---
import { now, nowUpdated } from '../data/now';
const colors = ['var(--yellow)', 'var(--pink)', 'var(--blue)', 'var(--green)'];
---

<section class="now" aria-labelledby="now-title">
  <h2 id="now-title">What I'm up to now</h2>
  <p class="updated">Last updated {nowUpdated}</p>
  <ul>
    {
      now.map((item, i) => (
        <li class={`sticker ${i % 2 ? 'tilt-right' : 'tilt-left'}`} style={`--accent: ${colors[i % colors.length]}`}>
          <span class="emoji" aria-hidden="true">{item.emoji}</span>
          <span class="label">{item.label}</span>
          <span class="text">{item.text}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .now {
    margin-top: 3rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 0;
  }

  .updated {
    margin: 0 0 1.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-top: 14px solid var(--accent);
  }

  .emoji {
    font-size: 2rem;
  }

  .label {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
  }
</style>
