---
const links = [
  { href: '/', label: 'Home', color: 'var(--yellow)' },
  { href: '/about/', label: 'About', color: 'var(--pink)' },
  { href: '/projects/', label: 'Projects', color: 'var(--blue)' },
  { href: '/blog/', label: 'Blog', color: 'var(--green)' },
  { href: '/contact/', label: 'Contact', color: 'var(--purple)' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header>
  <a href="/" class="logo" aria-label="Home">MB</a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              style={`--chip: ${link.color}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    width: min(1000px, 100% - 2rem);
    margin: 0 auto;
    padding: 1.25rem 0 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    /* leave room for the light switch cord on the right */
    padding-right: 3.5rem;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    font-weight: 800;
    text-decoration: none;
    color: #1d1a2f;
    background: var(--orange);
    border: var(--border);
    border-radius: 50%;
    box-shadow: var(--shadow);
    transform: rotate(-8deg);
    transition: transform 0.3s ease;
  }

  .logo:hover {
    transform: rotate(352deg) scale(1.1);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    border: var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.9rem;
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--chip);
    color: #1d1a2f;
    transform: rotate(-3deg);
  }
</style>
