---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <div class="lost">
    <p class="fox" aria-hidden="true">🐰</p>
    <h1 class="page-title">404: this bunny got lost</h1>
    <p>The page you're looking for doesn't exist (yet).</p>
    <a class="button" href="/">Take me home</a>
  </div>
</BaseLayout>

<style>
  .lost {
    text-align: center;
    padding: 3rem 0;
  }

  .fox {
    font-size: 5rem;
    margin: 0;
  }
</style>
