---
import BaseLayout from '../layouts/BaseLayout.astro';

// Add, remove or change these to your own accounts.
const links = [
  { label: 'GitHub', href: 'https://github.com/maartenbraeckman', emoji: '🐙', color: 'var(--purple)' },
  { label: 'Email', href: 'mailto:you@example.com', emoji: '💌', color: 'var(--pink)' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/', emoji: '💼', color: 'var(--blue)' },
];
---

<BaseLayout title="Contact" description="How to reach Maarten">
  <h1 class="page-title">Say hi!</h1>
  <p class="lead">Want to chat about AI, data, Japan or bunnies? Find me here:</p>

  <ul class="links">
    {
      links.map((link, i) => (
        <li>
          <a
            href={link.href}
            class={`sticker ${i % 2 ? 'tilt-right' : 'tilt-left'}`}
            style={`--accent: ${link.color}`}
          >
            <span class="emoji" aria-hidden="true">{link.emoji}</span>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .lead {
    font-size: 1.25rem;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
    background: var(--accent);
    color: #1d1a2f;
  }

  .emoji {
    font-size: 2rem;
  }
</style>
