---
import BaseLayout from '../layouts/BaseLayout.astro';

// Your toolbox. Add or remove whatever matches what you actually use.
const skills = [
  { name: 'Python', emoji: '🐍' },
  { name: 'SQL', emoji: '🗄️' },
  { name: 'Data pipelines', emoji: '🔀' },
  { name: 'Machine learning', emoji: '🧠' },
  { name: 'TypeScript', emoji: '🟦' },
  { name: 'HTML & CSS', emoji: '🎨' },
];

const facts = [
  { emoji: '🤖', text: 'Specializing in AI and data engineering' },
  { emoji: '🐰', text: 'Bunnies are the best, no discussion' },
  { emoji: '🗾', text: 'Favourite place: Fushimi Inari, with its thousand gates' },
  { emoji: '🍣', text: 'Will travel for sushi' },
  { emoji: '🦊', text: 'Spirit animal: the fennec fox' },
  { emoji: '🚃', text: 'Japanese trains are the best trains' },
];
---

<BaseLayout title="About" description="A little bit about Maarten">
  <h1 class="page-title">About me</h1>

  <div class="intro sticker tilt-left">
    <p>
      Hi! I'm Maarten. 👋 I'm specializing in AI and data engineering: building the pipelines that
      move data around and the models that learn from it. I also love making playful things for
      the web. This site is my sandbox, a place to show what I make and what I'm into.
    </p>
    <p>
      <em>Replace this text with your own story: where you're from, what you study or do, and what
      gets you excited.</em>
    </p>
  </div>

  <h2>My toolbox</h2>
  <ul class="skills">
    {
      skills.map((skill, i) => (
        <li class="skill" style={`--tilt: ${i % 2 ? 3 : -3}deg`}>
          <span aria-hidden="true">{skill.emoji}</span> {skill.name}
        </li>
      ))
    }
  </ul>

  <h2>Quick facts</h2>
  <ul class="facts">
    {
      facts.map((fact, i) => (
        <li class={`sticker ${i % 2 ? 'tilt-right' : 'tilt-left'}`}>
          <span aria-hidden="true">{fact.emoji}</span> {fact.text}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .intro {
    max-width: 42rem;
  }

  .intro p:first-child {
    margin-top: 0;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  h2 {
    margin-top: 3rem;
    font-size: 2rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    list-style: none;
    padding: 0;
  }

  .skill {
    font-weight: 700;
    color: #1d1a2f;
    background: var(--green);
    border: var(--border);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--ink);
    padding: 0.3rem 1rem;
    transform: rotate(var(--tilt));
    transition: transform 0.2s ease;
  }

  .skill:nth-child(3n + 2) {
    background: var(--blue);
  }

  .skill:nth-child(3n) {
    background: var(--yellow);
  }

  .skill:hover {
    transform: rotate(0deg) scale(1.08);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .facts span {
    font-size: 1.5rem;
    margin-right: 0.3rem;
  }
</style>
